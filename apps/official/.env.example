# Public site URL (used for callbacks)
SITE_URL=https://your-vercel-site.vercel.app

# Supabase
SUPABASE_URL=
SUPABASE_ANON_KEY=
SUPABASE_SERVICE_ROLE_KEY=

# Postgres (Supabase) connection string for better-auth/drizzle
DATABASE_URL=postgresql://user:password@host:5432/db

# Better Auth secret
BETTER_AUTH_SECRET=change-me

# SMTP (邮件验证码发送)
SMTP_HOST=
SMTP_PORT=
SMTP_USER=
SMTP_PASS=
SMTP_FROM="PixelForge <no-reply@yourdomain.com>"
