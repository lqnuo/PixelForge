# Better Auth secret for signing tokens/cookies
NUXT_AUTH_SECRET=change-me-strong-secret

# Public base URL of the site (optional; autodetected in most cases)
# NUXT_PUBLIC_AUTH_BASE_URL=http://localhost:3000

# Email provider key (optional; integrate in server/api/auth/[...].ts)
# NUXT_RESEND_API_KEY=
